{
  "name": "boom",
  "version": "0.34.0",
  "description": "BoomTube \u2014 declarative dev-machine setup (executable: boom). Converge your machine from a declarative boomfile.toml \u2014 dotfiles, packages, and tools (sync/verify) with drift detection.",
  "type": "module",
  "private": true,
  "bin": {
    "boom": "./build/boom"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile build/boom",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && bun test"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@stricli/core": "1.3.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
